ANTHROPIC_API_KEY=
DAYTONA_API_KEY=
ARIZE_SPACE_ID=
ARIZE_API_KEY=

# Optional
# CTRLZ_SNAPSHOT=daytona-small        # use daytona-vm-small once Linux VM sandboxes are enabled (native fork)
